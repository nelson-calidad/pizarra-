const HEADERS={NOTAS:['ID','TEXTO','DESCRIPCION','ESTADO','FECHA','HORA','CATEGORIA','PRIORIDAD','COLOR','FIJADA','X','Y','ANCHO','ALTO','CREADO_EN','ACTUALIZADO_EN','COMPLETADO_EN','ARCHIVADO','RECORDATORIO','REPETICION','ORDEN','TIPO'],CHECKLIST:['ID','NOTA_ID','TEXTO','COMPLETADO','ORDEN'],ETIQUETAS:['ID','NOMBRE','COLOR'],CONFIG:['CLAVE','VALOR']};
function doGet(e){return json_(route_(e.parameter||{}))}function doPost(e){try{return json_(route_(JSON.parse(e.postData.contents||'{}')))}catch(x){return json_({success:false,error:x.message})}}function json_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function setupSpreadsheet(){const s=SpreadsheetApp.getActive();Object.keys(HEADERS).forEach(n=>{let sh=s.getSheetByName(n);if(!sh)sh=s.insertSheet(n);if(!sh.getLastRow())sh.appendRow(HEADERS[n])});return Object.keys(HEADERS)}
function route_(p){try{if(p.action==='setupSpreadsheet')return{success:true,data:setupSpreadsheet(),message:'Hojas preparadas'};if(p.action==='getNotes')return{success:true,data:read_('NOTAS')};if(p.action==='getNote')return{success:true,data:read_('NOTAS').find(n=>n.ID===p.id)||null};if(p.action==='getChecklist')return{success:true,data:read_('CHECKLIST').filter(n=>n.NOTA_ID===p.noteId)};if(p.action==='getTags')return{success:true,data:read_('ETIQUETAS')};if(p.action==='createNote')return create_(p.data||{});if(['updateNote','moveNote','updatePosition'].includes(p.action))return update_('NOTAS',p.id,p.data||p);if(p.action==='completeNote')return update_('NOTAS',p.id,{ESTADO:'HECHO',COMPLETADO_EN:new Date().toISOString()});if(p.action==='reopenNote')return update_('NOTAS',p.id,{ESTADO:'PENDIENTE',COMPLETADO_EN:''});if(p.action==='archiveNote')return update_('NOTAS',p.id,{ESTADO:'ARCHIVADO',ARCHIVADO:true});if(p.action==='deleteNote')return del_('NOTAS',p.id);if(p.action==='createChecklistItem')return checklist_(p.data||{});if(p.action==='updateChecklistItem')return update_('CHECKLIST',p.id,p.data||{});if(p.action==='deleteChecklistItem')return del_('CHECKLIST',p.id);return{success:false,error:'Acción no reconocida'}}catch(x){return{success:false,error:x.message}}}
function sh_(n){const x=SpreadsheetApp.getActive().getSheetByName(n);if(!x)throw Error('Ejecutá setupSpreadsheet primero');return x}function read_(n){const a=sh_(n).getDataRange().getValues();if(a.length<2)return[];const h=a.shift();return a.map(r=>h.reduce((o,k,i)=>(o[k]=r[i],o),{}))}function append_(n,o){sh_(n).appendRow(HEADERS[n].map(k=>o[k]===undefined?'':o[k]))}
function create_(d){const now=new Date().toISOString(),o=Object.assign({ID:Utilities.getUuid(),TEXTO:'',DESCRIPCION:'',ESTADO:'PENDIENTE',FECHA:'',HORA:'',CATEGORIA:'General',PRIORIDAD:'NORMAL',COLOR:'yellow',FIJADA:false,X:120,Y:120,ANCHO:255,ALTO:145,CREADO_EN:now,ACTUALIZADO_EN:now,COMPLETADO_EN:'',ARCHIVADO:false,RECORDATORIO:false,REPETICION:'',ORDEN:0,TIPO:'NOTA'},d);append_('NOTAS',o);return{success:true,data:o,message:'Nota creada'}}function checklist_(d){const o=Object.assign({ID:Utilities.getUuid(),NOTA_ID:'',TEXTO:'',COMPLETADO:false,ORDEN:0},d);append_('CHECKLIST',o);return{success:true,data:o}}
function update_(n,id,d){const s=sh_(n),a=s.getDataRange().getValues(),h=a[0],r=a.findIndex((x,i)=>i&&String(x[0])===String(id));if(r<1)return{success:false,error:'Registro no encontrado'};d.ACTUALIZADO_EN=d.ACTUALIZADO_EN||new Date().toISOString();h.forEach((k,i)=>{if(Object.prototype.hasOwnProperty.call(d,k))s.getRange(r+1,i+1).setValue(d[k])});return{success:true,data:Object.assign({ID:id},d),message:'Actualizado'}}function del_(n,id){const s=sh_(n),r=s.getDataRange().getValues().findIndex((x,i)=>i&&String(x[0])===String(id));if(r<1)return{success:false,error:'Registro no encontrado'};s.deleteRow(r+1);return{success:true,data:{id:id},message:'Eliminado'}}
